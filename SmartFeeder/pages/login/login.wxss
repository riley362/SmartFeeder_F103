/* pages/login/login.wxss — 安全验证页样式 */

.login-page {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 0 48rpx;
  background-color: #F5F7FA;
}

/* ========== Header ========== */
.login-header {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: 180rpx;
  margin-bottom: 80rpx;
}

.logo-circle {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #32B5A0 0%, #6DD5C4 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 32rpx;
  box-shadow: 0 8rpx 32rpx rgba(50, 181, 160, 0.25);
}

.logo-icon {
  font-size: 60rpx;
}

.app-name {
  font-size: 40rpx;
  font-weight: 700;
  color: #1D1D1F;
  letter-spacing: 2rpx;
}

.app-subtitle {
  font-size: 24rpx;
  color: #8E8E93;
  margin-top: 8rpx;
  letter-spacing: 1rpx;
}

/* ========== Card ========== */
.login-card {
  width: 100%;
  padding: 48rpx 40rpx;
}

.login-label {
  display: block;
  font-size: 28rpx;
  font-weight: 500;
  color: #3A3A3C;
  margin-bottom: 24rpx;
}

.login-input {
  width: 100%;
  height: 96rpx;
  background: #F5F7FA;
  border-radius: 20rpx;
  padding: 0 32rpx;
  font-size: 32rpx;
  color: #1D1D1F;
  letter-spacing: 8rpx;
}

/* ========== 显示密码 ========== */
.show-pwd-row {
  display: flex;
  align-items: center;
  margin-top: 20rpx;
  margin-bottom: 8rpx;
}

.checkbox {
  width: 36rpx;
  height: 36rpx;
  border-radius: 8rpx;
  border: 2rpx solid #C7C7CC;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 12rpx;
  transition: all 0.2s;
}

.checkbox.checked {
  background: #32B5A0;
  border-color: #32B5A0;
}

.check-mark {
  color: #FFFFFF;
  font-size: 22rpx;
  font-weight: 700;
}

.show-pwd-text {
  font-size: 24rpx;
  color: #8E8E93;
}

/* ========== Error ========== */
.error-msg {
  display: block;
  font-size: 24rpx;
  color: #FF3B30;
  margin-top: 16rpx;
  margin-bottom: -8rpx;
}

/* ========== Button ========== */
.login-btn {
  width: 100%;
  height: 96rpx;
  border-radius: 20rpx;
  background: #C7C7CC;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 40rpx;
  transition: background 0.3s;
}

.login-btn.active {
  background: linear-gradient(135deg, #32B5A0 0%, #3CC4AE 100%);
  box-shadow: 0 8rpx 24rpx rgba(50, 181, 160, 0.3);
}

.login-btn-text {
  font-size: 32rpx;
  font-weight: 600;
  color: #FFFFFF;
  letter-spacing: 2rpx;
}

/* ========== Footer ========== */
.footer-hint {
  margin-top: 60rpx;
  font-size: 22rpx;
  color: #C7C7CC;
  letter-spacing: 1rpx;
}
