/* pages/dashboard/dashboard.wxss — Apple 极简风 */

/* ========== 页面容器 ========== */
.page {
  min-height: 100vh;
  padding: 20rpx 36rpx;
  background: #F5F5F7;
}

/* ========== 连接状态胶囊 ========== */
.status-bar {
  display: flex;
  justify-content: flex-end;
  padding: 8rpx 4rpx 0;
}

.status-pill {
  display: flex;
  align-items: center;
  padding: 10rpx 20rpx;
  border-radius: 32rpx;
  background: #FFFFFF;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.status-pill .status-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  margin-right: 10rpx;
  flex-shrink: 0;
}

.status-pill .status-text {
  font-size: 22rpx;
  font-weight: 500;
  color: #1D1D1F;
  letter-spacing: 1rpx;
}

/* 绿：设备实时在线 */
.status-online .status-dot {
  background: #34C759;
  box-shadow: 0 0 0 6rpx rgba(52, 199, 89, 0.18);
  animation: pulse 2s ease-in-out infinite;
}

/* 黄：云端已连，但未收到设备数据 */
.status-idle .status-dot {
  background: #FF9F0A;
}
.status-idle .status-text {
  color: #8E6A0A;
}

/* 红：云端未连 */
.status-offline .status-dot {
  background: #FF3B30;
}
.status-offline .status-text {
  color: #A32520;
}

@keyframes pulse {
  0%, 100% { opacity: 1; }
  50%      { opacity: 0.5; }
}

/* ========== 章节标题 ========== */
.section-header {
  padding: 36rpx 0 20rpx 4rpx;
}

.section-label {
  font-size: 26rpx;
  font-weight: 500;
  color: #86868B;
  letter-spacing: 2rpx;
  text-transform: uppercase;
}

/* ================================================
   1. 状态纵览 · 2x2 Grid
   ================================================ */
.grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
}

.tile {
  background: #FFFFFF;
  border-radius: 32rpx;
  padding: 32rpx 28rpx 28rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  min-height: 220rpx;
  box-shadow: 0 8px 40px rgba(0, 0, 0, 0.04);
}

.tile-label {
  font-size: 22rpx;
  font-weight: 500;
  color: #86868B;
  letter-spacing: 1rpx;
}

.tile-value-row {
  display: flex;
  align-items: baseline;
  margin-top: 16rpx;
}

.tile-num {
  font-size: 64rpx;
  font-weight: 600;
  color: #1D1D1F;
  line-height: 1;
  font-family: -apple-system, 'Helvetica Neue', sans-serif;
}

.tile-unit {
  font-size: 22rpx;
  font-weight: 400;
  color: #86868B;
  margin-left: 6rpx;
  position: relative;
  top: -2rpx;
}

/* 空气质量颜色 */
.quality-good  { color: #34C759; }
.quality-moderate { color: #FF9F0A; }
.quality-bad   { color: #FF3B30; }

/* ---- 进度条 ---- */
.bar-track {
  width: 100%;
  height: 6rpx;
  background: #F2F2F7;
  border-radius: 3rpx;
  margin-top: 20rpx;
  overflow: hidden;
}

.bar-fill {
  height: 100%;
  border-radius: 3rpx;
  transition: width 0.8s cubic-bezier(0.25, 1, 0.5, 1);
}

.bar-water {
  background: #0A84FF;
}

.bar-food {
  background: #FF9F0A;
}

/* 低位告警：饮水/食物不足时进度条转红 */
.bar-low {
  background: #FF3B30;
}

/* ---- 标签行（支持右侧告警徽标） ---- */
.tile-label-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.tile-warn {
  font-size: 20rpx;
  font-weight: 600;
  color: #FFFFFF;
  background: #FF3B30;
  padding: 2rpx 14rpx;
  border-radius: 16rpx;
  letter-spacing: 1rpx;
}

/* 数值本身在低位时染红 */
.num-low {
  color: #FF3B30 !important;
}

/* ================================================
   AI 宠物识别 · 通栏
   ================================================ */
.card-ai {
  background: #FFFFFF;
  border-radius: 32rpx;
  padding: 36rpx 32rpx;
  margin-top: 16rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-shadow: 0 8px 40px rgba(0, 0, 0, 0.04);
}

.ai-left {
  display: flex;
  flex-direction: column;
}

.ai-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #1D1D1F;
  line-height: 1.2;
}

.ai-sub {
  font-size: 22rpx;
  font-weight: 400;
  color: #86868B;
  margin-top: 6rpx;
  letter-spacing: 1rpx;
}

.ai-right {
  display: flex;
  align-items: center;
}

/* 呼吸灯小圆点 */
.ai-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #D1D1D6;
  margin-right: 14rpx;
  flex-shrink: 0;
}

.ai-dot.active {
  background: #34C759;
  animation: breathe 2s ease-in-out infinite;
}

@keyframes breathe {
  0%, 100% { opacity: 1; box-shadow: 0 0 0 0 rgba(52, 199, 89, 0.4); }
  50%      { opacity: 0.6; box-shadow: 0 0 0 10rpx rgba(52, 199, 89, 0); }
}

.ai-status {
  font-size: 28rpx;
  font-weight: 500;
  color: #1D1D1F;
}

/* ================================================
   2. 控制中心
   ================================================ */
.card-ctrl {
  background: #FFFFFF;
  border-radius: 32rpx;
  padding: 36rpx 32rpx 40rpx;
  box-shadow: 0 8px 40px rgba(0, 0, 0, 0.04);
}

/* ---- iOS Segmented Control ---- */
.seg-wrap {
  margin-bottom: 36rpx;
}

.seg {
  display: flex;
  background: #F2F2F7;
  border-radius: 18rpx;
  padding: 6rpx;
}

.seg-item {
  flex: 1;
  text-align: center;
  padding: 18rpx 0;
  font-size: 26rpx;
  font-weight: 500;
  color: #86868B;
  border-radius: 14rpx;
  transition: all 0.28s cubic-bezier(0.25, 1, 0.5, 1);
  position: relative;
  z-index: 1;
}

.seg-active {
  background: #FFFFFF;
  color: #1D1D1F;
  font-weight: 600;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.08);
}

/* ---- 面板容器 ---- */
.panel {
  transition: opacity 0.3s ease;
}

.panel-off {
  opacity: 0.4;
  pointer-events: none;
}

/* ---- 控制行 ---- */
.ctrl-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 0;
}

.ctrl-meta {
  display: flex;
  align-items: center;
}

/* 状态小圆点 */
.dot-indicator {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #D1D1D6;
  margin-right: 16rpx;
  flex-shrink: 0;
  transition: background 0.3s;
}

.dot-on {
  background: #34C759;
}

.ctrl-name {
  font-size: 30rpx;
  font-weight: 500;
  color: #1D1D1F;
}

/* ---- Toggle 开关（iOS 风格） ---- */
.toggle {
  width: 102rpx;
  height: 56rpx;
  border-radius: 28rpx;
  background: #E5E5EA;
  padding: 4rpx;
  display: flex;
  align-items: center;
  transition: background 0.25s ease;
}

.toggle-on {
  background: #34C759;
}

.toggle-knob {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: #FFFFFF;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.12);
  transition: transform 0.25s cubic-bezier(0.25, 1, 0.5, 1);
}

.toggle-on .toggle-knob {
  transform: translateX(46rpx);
}

/* ---- 分隔线 ---- */
.sep {
  height: 1rpx;
  background: #F2F2F7;
}

/* ---- 投喂量输入 ---- */
.amount-box {
  display: flex;
  align-items: center;
  border-bottom: 2rpx solid #E5E5EA;
  padding-bottom: 4rpx;
}

.amount-input {
  width: 100rpx;
  text-align: right;
  font-size: 34rpx;
  font-weight: 600;
  color: #1D1D1F;
  font-family: -apple-system, 'Helvetica Neue', sans-serif;
}

.amount-unit {
  font-size: 24rpx;
  font-weight: 400;
  color: #86868B;
  margin-left: 6rpx;
}

/* ---- 立即投喂按钮 ---- */
.btn-feed {
  margin-top: 36rpx;
  width: 100%;
  height: 100rpx;
  border-radius: 50rpx;
  background: #1D1D1F;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: opacity 0.25s ease;
}

.btn-feed:active {
  opacity: 0.85;
}

.btn-off {
  opacity: 0.4;
}

.btn-feed-text {
  font-size: 30rpx;
  font-weight: 600;
  color: #FFFFFF;
  letter-spacing: 4rpx;
}

/* ================================================
   3. 定时喂食
   ================================================ */
.card-sched {
  background: #FFFFFF;
  border-radius: 32rpx;
  padding: 32rpx;
  box-shadow: 0 8px 40px rgba(0, 0, 0, 0.04);
}

/* ---- 新增计划行 ---- */
.sched-add-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.sched-time-btn {
  min-width: 140rpx;
  height: 72rpx;
  line-height: 72rpx;
  text-align: center;
  background: #F2F2F7;
  border-radius: 18rpx;
  font-size: 34rpx;
  font-weight: 600;
  color: #1D1D1F;
  font-family: -apple-system, 'Helvetica Neue', sans-serif;
}

.sched-amount-wrap {
  display: flex;
  align-items: center;
  background: #F2F2F7;
  border-radius: 18rpx;
  padding: 0 16rpx;
  height: 72rpx;
  flex: 1;
}

.sched-amount-input {
  flex: 1;
  font-size: 34rpx;
  font-weight: 600;
  color: #1D1D1F;
  text-align: center;
  font-family: -apple-system, 'Helvetica Neue', sans-serif;
}

.sched-amount-unit {
  font-size: 24rpx;
  color: #86868B;
  margin-left: 4rpx;
}

.sched-add-btn {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: #1D1D1F;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.sched-add-btn:active {
  opacity: 0.8;
}

.sched-add-icon {
  font-size: 40rpx;
  color: #FFFFFF;
  font-weight: 300;
  line-height: 1;
}

/* ---- 空状态 ---- */
.sched-empty {
  padding: 36rpx 0 8rpx;
  text-align: center;
}

.sched-empty-text {
  font-size: 24rpx;
  color: #AEAEB2;
}

/* ---- 计划列表项 ---- */
.sched-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 0;
  border-top: 1rpx solid #F2F2F7;
  margin-top: 16rpx;
}

.sched-item:first-of-type {
  margin-top: 24rpx;
}

.sched-item-left {
  display: flex;
  align-items: baseline;
  gap: 16rpx;
}

.sched-item-time {
  font-size: 44rpx;
  font-weight: 600;
  color: #1D1D1F;
  font-family: -apple-system, 'Helvetica Neue', sans-serif;
  line-height: 1;
}

.sched-item-amount {
  font-size: 26rpx;
  font-weight: 500;
  color: #86868B;
}

.sched-item-done {
  font-size: 20rpx;
  font-weight: 600;
  color: #FFFFFF;
  background: #34C759;
  padding: 2rpx 12rpx;
  border-radius: 12rpx;
}

.sched-item-right {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

/* 小号 toggle */
.toggle-sm {
  width: 80rpx;
  height: 44rpx;
  border-radius: 22rpx;
  padding: 3rpx;
}

.toggle-sm .toggle-knob {
  width: 38rpx;
  height: 38rpx;
}

.toggle-sm.toggle-on .toggle-knob {
  transform: translateX(36rpx);
}

/* 删除按钮 */
.sched-del {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: #F2F2F7;
  display: flex;
  align-items: center;
  justify-content: center;
}

.sched-del:active {
  background: #FF3B30;
}

.sched-del:active .sched-del-icon {
  color: #FFFFFF;
}

.sched-del-icon {
  font-size: 32rpx;
  color: #AEAEB2;
  font-weight: 600;
  line-height: 1;
}

/* ================================================
   4. 系统信息
   ================================================ */
.sys-footer {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx 0 0;
}

.sys-text {
  font-size: 22rpx;
  font-weight: 400;
  color: #AEAEB2;
  letter-spacing: 1rpx;
}

.sys-dot {
  width: 6rpx;
  height: 6rpx;
  border-radius: 50%;
  background: #D1D1D6;
  margin: 0 16rpx;
}
